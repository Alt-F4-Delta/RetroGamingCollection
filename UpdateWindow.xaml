<Window x:Class="RetroGamingCollection.UpdateWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Update available" Width="650" Height="530" MinWidth="500" MinHeight="400" WindowStartupLocation="CenterOwner" Background="#090821" Foreground="#D7D7FF">
  <Grid Margin="22">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock x:Name="VersionText" FontSize="23" FontWeight="Bold" Foreground="#AFA8FF" TextWrapping="Wrap"/>
    <TextBlock Grid.Row="1" Text="WHAT'S NEW" Margin="0,18,0,8" Foreground="#8F8ADF"/>
    <TextBox x:Name="NotesBox" Grid.Row="2" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Background="#121039" Foreground="#D7D7FF" BorderBrush="#39328C" Padding="12" FontFamily="Consolas"/>
    <TextBlock Grid.Row="3" Margin="0,12,0,6" TextWrapping="Wrap" Text="Download is verified before opening Setup. Setup lets you review or cancel installation. Your library settings and saves are preserved."/>
    <StackPanel Grid.Row="4"><ProgressBar x:Name="DownloadProgress" Height="10" Minimum="0" Maximum="100" Visibility="Collapsed"/><TextBlock x:Name="DownloadStatus" Margin="0,5,0,5" TextWrapping="Wrap"/></StackPanel>
    <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="InstallButton" Content="DOWNLOAD AND INSTALL" Click="Install_Click"/><Button Content="LATER / CANCEL" Click="Cancel_Click"/></StackPanel>
  </Grid>
</Window>
